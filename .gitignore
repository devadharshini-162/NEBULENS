# ============================================================
# NEBULENS — .gitignore
# ============================================================

# --- Environment & secrets ---
.env
.env.local

# --- Python virtual environment ---
.venv/
venv/
env/

# --- Python bytecode ---
__pycache__/
*.py[cod]
*.pyo

# --- Distribution / packaging ---
*.egg-info/
dist/
build/
*.egg
*.whl

# --- Node.js ---
node_modules/
frontend/node_modules/
frontend/dist/

# --- Testing & coverage ---
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints/

# --- Data — never commit raw downloads ---
data/raw/

# --- IDE and OS artefacts ---
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Type checking ---
.mypy_cache/
.ruff_cache/

# Milestone step reports and transient working documents
docs/reports/
.~lock.*
*.docx

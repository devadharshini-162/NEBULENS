# ============================================================
# NEBULENS — Environment Configuration Template
# ============================================================
#
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control (.env is in .gitignore).
#
# 1. NASA FIRMS MAP_KEY (For Live Satellite Fire Hotspots)
#    - Free registration: https://firms.modaps.eosdis.nasa.gov/api/map_key/
#    - Format: 32-character hexadecimal key
#
FIRMS_MAP_KEY=your_firms_map_key_here

# 2. NASA Earthdata Login Token (For MCD64A1 Burned Area / LP DAAC)
#    - Free registration: https://urs.earthdata.nasa.gov/
#    - Authorize "LP DAAC Data Pool" in Authorized Apps
#    - Generate token under Profile -> Generate Token
#
EARTHDATA_TOKEN=your_earthdata_bearer_token_here
Earthdata_Token=your_earthdata_bearer_token_here

# 3. Optional: Backend API Host and Port Settings
#
API_HOST=127.0.0.1
API_PORT=8000
